{
  "manifest_version": 3,
  "name": "FigCopy",
  "version": "1.0.3",
  "description": "Select any element on the page and copy its layout/style tree to paste into the companion Figma plugin.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "debugger", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FigCopy",
    "default_icon": "icon.png"
  },

  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
