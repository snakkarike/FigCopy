{
  "manifest_version": 3,
  "name": "FigCopy",
  "version": "1.0.0",
  "description": "Select any element on the page and copy its layout/style tree to paste into the companion Figma plugin.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FigCopy"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
